# ==============================================================================
# MEHER MAHEL LUXURY BOUTIQUE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CURRENCY=INR

# Authentication & Session Security (JWT)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (used for secure database bootstrapping)
ADMIN_EMAIL=admin@mehermahel.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Supabase Configuration (Optional / Hybrid PostgreSQL Integration)
# Retrieve from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Transactional Email Provider (Optional / Resend or SMTP)
EMAIL_FROM="Meher Mahel Atelier <concierge@mehermahel.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_or_smtp_password

# Razorpay API Credentials
# Retrieve from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Store Business Information
STORE_WHATSAPP_NUMBER=+91 76098 74187
STORE_UPI_ID=7609874187@ibl
